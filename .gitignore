# Archivos que nunca se suben al repo (público).
# Las claves de verdad viven en Render/Vercel o en tu .env local.

# --- Variables de entorno y secretos (solo se sube el ejemplo) ---
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.crt
*.p8
*.p12
*.pfx
*.jks
*.keystore
client_secret*.json
credentials*.json
service-account*.json
google-services.json
GoogleService-Info.plist

# --- Dependencias ---
node_modules/
.pnpm-store/

# --- Builds y cachés ---
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.eslintcache
backend/target/
target/
.mvn/wrapper/maven-wrapper.jar
.gradle/

