# Copiá este archivo a .env (no se sube a git). Todo es opcional para probar en local.

# Contraseña de Postgres (cambiala fuera de local).
DB_PASSWORD=in2u

# Login con Google: OAuth Client ID de tipo "Web application" en Google Cloud.
# Redirect URI autorizada: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Consejos con IA, gratis: key de https://aistudio.google.com/apikey (sin tarjeta).
# Sin key los consejos igual se generan, con reglas según el ánimo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Solo para probar sin Google: permite POST /api/dev/login con cualquier email.
# NUNCA en producción.
DEV_LOGIN=false
