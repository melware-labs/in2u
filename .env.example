# Copia este archivo a .env (no se sube a git). Todo es opcional para probar en local.
# Para entrar sin Google: DEV_LOGIN=true docker compose up --build

# Contraseña de Postgres (cámbiala fuera de local).
DB_PASSWORD=in2u

# Login con Google: OAuth Client ID de tipo "Web application" en Google Cloud.
# Redirect URI autorizada: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Consejos con IA, gratis: key de https://aistudio.google.com/apikey (sin tarjeta).
# Sin key los consejos igual se generan, con reglas según el ánimo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Por privacidad solo se envía el número del ánimo a Gemini. Con true también se
# envían las notas escritas (el plan gratuito de Google puede usar esos datos).
GEMINI_SEND_NOTES=false

# true cuando el sitio se sirve por https (producción); false en local.
COOKIE_SECURE=false

# Solo para probar sin Google: permite POST /api/dev/login con cualquier email.
# NUNCA en producción.
DEV_LOGIN=false

# Solo producción (Render): en local no hacen falta.
# OAUTH_REDIRECT_URI=https://in2u.vercel.app/login/oauth2/code/google
# FRONTEND_URL=https://in2u.vercel.app
# DB_URL=jdbc:postgresql://HOST/BASE?sslmode=require
# DB_USER=

# Notificaciones push (opcional): genera tus claves con
# `npx web-push generate-vapid-keys`. Sin claves, push queda apagado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Puerto local de docker compose (8080 por defecto).
# WEB_PORT=8080
